# Oracle Cloud deployment settings
APP_NAME=seungyo-app
ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api-server:8000

# Use a domain for automatic HTTPS. For an initial IP-only test, use :80.
MY9_DOMAIN=:80

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seungyo
POSTGRES_USER=seungyo
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://seungyo:replace-with-a-long-random-password@postgres:5432/seungyo
SYNC_DATABASE_URL=postgresql://seungyo:replace-with-a-long-random-password@postgres:5432/seungyo

# Redis
REDIS_URL=redis://redis:6379/0

# API security
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=["*"]

# Worker
DATA_SOURCE_MODE=kbo
KBO_BASE_URL=https://www.koreabaseball.com
CHROME_BINARY=/usr/bin/chromium
CHROME_HEADLESS=true
CHROME_KEEP_OPEN=false
CHROME_PAGE_TIMEOUT_SECONDS=30
CHROME_PAGE_SETTLE_SECONDS=1.5
CHROME_BOXSCORE_SETTLE_SECONDS=0.2
CHROME_CACHE_TTL_SECONDS=30
STARTUP_BACKFILL_DAYS=30
SCHEDULE_END_MONTH=11
SCHEDULE_END_DAY=30
