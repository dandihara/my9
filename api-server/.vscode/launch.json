{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Debug with Alembic",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "preLaunchTask": "alembic-upgrade-head"
    }
  ]
}
