# App
APP_NAME=seungyo-app
ENV=local
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
MY9_LOCAL_API_URL=http://LOCAL_API_HOST:8000
MY9_EXTERNAL_API_URL=https://PUBLIC_API_HOST

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seungyo
POSTGRES_USER=seungyo
POSTGRES_PASSWORD=seungyo_password
DATABASE_URL=postgresql+asyncpg://seungyo:seungyo_password@postgres:5432/seungyo
SYNC_DATABASE_URL=postgresql://seungyo:seungyo_password@postgres:5432/seungyo

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# External data source
KBO_BASE_URL=https://www.koreabaseball.com
KBO_EVENT_URL_TEMPLATE={base_url}/Schedule/GameCenter/Main.aspx?gameDate={game_date}&gameId={game_id}&section=REVIEW
DATA_SOURCE_MODE=mock
STARTUP_BACKFILL_DAYS=30
SCHEDULE_END_MONTH=11
SCHEDULE_END_DAY=30

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
